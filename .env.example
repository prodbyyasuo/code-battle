APP_NAME=Code Battle
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

POSTGRES_DB=code_battle
POSTGRES_USER=code_battle
POSTGRES_PASSWORD=code_battle
POSTGRES_PUBLIC_PORT=5432
DATABASE_URL=postgresql+asyncpg://code_battle:code_battle@localhost:5432/code_battle
SQL_ECHO=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=30

MONGO_ROOT_USERNAME=code_battle
MONGO_ROOT_PASSWORD=code_battle
MONGO_PUBLIC_PORT=27017
MONGODB_URL=mongodb://code_battle:code_battle@localhost:27017/?authSource=admin
MONGODB_DATABASE=code_battle_tests
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_PUBLIC_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
